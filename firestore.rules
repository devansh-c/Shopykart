
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment Timestamp: 2024-03-20T16:15:00Z
    
    // Helper function for Auth
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Orders: Full access for any authenticated user during prototyping
    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    // Products, Banners, Categories, Coupons: Public Read, Auth Write
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Vendor Data
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isSignedIn();
      
      match /products/{productId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
    
    // Vendor Applications
    match /vendor_applications/{appId} {
      allow read, write: if isSignedIn();
    }

    // User Profiles & FCM Tokens
    match /users/{userId} {
      allow read: if isSignedIn();
      
      match /profile/data {
        allow read, write: if isSignedIn();
      }
      
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn();
      }
    }
    
    // Catch-all for any other collections
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
