
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to check user role from their profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/data).data;
    }

    // Global Products & Banners
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn(); // Allowing for prototype, restrict to admin in prod
    }
    
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Vendor Profiles & Their Products
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isSignedIn(); // Allow admin to activate stores
      
      match /products/{productId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
    
    match /vendor_applications/{appId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn(); 
    }

    // Orders
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn(); // Allow admin and owner to read
      allow update: if isSignedIn(); 
    }

    // User Data & FCM Tokens
    match /users/{userId} {
      allow read: if isOwner(userId) || isSignedIn(); // Allow admin to see customer list
      
      match /profile/data {
        allow read, write: if isOwner(userId) || isSignedIn();
      }
      
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
