
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment Timestamp: 2024-03-20T16:45:00Z (Force update)
    
    // FULL ACCESS FOR PROTOTYPING
    // This allows any request to read or write to any collection.
    // This is strictly for fixing the persistent "Access Restricted" error.
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Explicit match for orders just in case
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Explicit match for user data
    match /users/{userId}/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
