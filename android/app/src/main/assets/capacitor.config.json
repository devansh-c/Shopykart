{
	"appId": "co.in.shopykart.app",
	"appName": "ShopyKart",
	"webDir": "out",
	"server": {
		"androidScheme": "https",
		"cleartext": true,
		"allowNavigation": [
			"shopykart.co.in",
			"*.shopykart.co.in"
		]
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_notification",
			"iconColor": "#FF5200"
		}
	}
}
