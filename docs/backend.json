
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A food item in the menu",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isVeg": { "type": "boolean" },
        "vendorId": { "type": "string" },
        "badges": {
          "type": "array",
          "items": { "type": "string", "enum": ["Best Seller", "Featured", "Trending"] }
        }
      },
      "required": ["name", "price", "category"]
    },
    "Store": {
      "title": "Vendor Store",
      "description": "Information about a restaurant or store vendor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "rating": { "type": "number" },
        "deliveryTime": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "isOpen": { "type": "boolean" }
      },
      "required": ["name", "imageUrl"]
    },
    "Banner": {
      "title": "Homepage Banner",
      "description": "Promotional banners for the slider",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "tag": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["title", "imageUrl"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "Details of a placed order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Preparing", "Out for Delivery", "Delivered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended information about the user including location",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "address": { "type": "string" },
            "updatedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "#/entities/Product",
      "description": "Collection of menu items"
    },
    "/stores/{storeId}": {
      "schema": "#/entities/Store",
      "description": "Collection of vendor stores"
    },
    "/banners/{bannerId}": {
      "schema": "#/entities/Banner",
      "description": "Collection of homepage promotional banners"
    },
    "/orders/{orderId}": {
      "schema": "#/entities/Order",
      "description": "Collection of customer orders"
    },
    "/users/{userId}/profile": {
      "schema": "#/entities/UserProfile",
      "description": "User specific data and location"
    },
    "/stats/summary": {
      "schema": "object",
      "description": "Global statistics for the admin dashboard"
    }
  }
}
