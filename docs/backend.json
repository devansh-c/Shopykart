
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A food item in the menu",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isVeg": { "type": "boolean" },
        "vendorId": { "type": "string" },
        "restaurantName": { "type": "string" },
        "town": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "vendorId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "coinsEarned": { "type": "number" },
        "coinsUsed": { "type": "number" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "coins": { "type": "number", "default": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CheckoutCharge": {
      "title": "Checkout Charge",
      "description": "Additional charges applied during checkout",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["fixed", "percentage"] },
        "value": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/vendors/{vendorId}": { "schema": "object", "description": "Store profiles" },
    "/vendors/{vendorId}/products/{productId}": { "schema": "#/entities/Product", "description": "Vendor specific products" },
    "/products/{productId}": { "schema": "#/entities/Product", "description": "Global products for search" },
    "/orders/{orderId}": { "schema": "#/entities/Order", "description": "Global orders" },
    "/banners/{bannerId}": { "schema": "object", "description": "Promotional banners" },
    "/coupons/{couponId}": { "schema": "object", "description": "Discount codes" },
    "/categories/{categoryId}": { "schema": "object", "description": "Food categories" },
    "/vendor_applications/{appId}": { "schema": "object", "description": "New store requests" },
    "/users/{userId}/fcmTokens/{tokenId}": { "schema": "object", "description": "User notification tokens" },
    "/users/{userId}/profile/data": { "schema": "#/entities/UserProfile", "description": "User profile information" },
    "/checkout_charges/{chargeId}": { "schema": "#/entities/CheckoutCharge", "description": "Dynamic tax and service charges" }
  }
}
