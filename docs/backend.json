
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A food item in the menu",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isVeg": { "type": "boolean" },
        "vendorId": { "type": "string" },
        "restaurantName": { "type": "string" },
        "town": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "vendorId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FCMToken": {
      "title": "FCM Token",
      "description": "Browser push notification token",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "deviceType": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/vendors/{vendorId}": { "schema": "object", "description": "Store profiles" },
    "/vendors/{vendorId}/products/{productId}": { "schema": "#/entities/Product", "description": "Vendor specific products" },
    "/products/{productId}": { "schema": "#/entities/Product", "description": "Global products for search" },
    "/orders/{orderId}": { "schema": "#/entities/Order", "description": "Global orders" },
    "/banners/{bannerId}": { "schema": "object", "description": "Promotional banners" },
    "/coupons/{couponId}": { "schema": "object", "description": "Discount codes" },
    "/categories/{categoryId}": { "schema": "object", "description": "Food categories" },
    "/vendor_applications/{appId}": { "schema": "object", "description": "New store requests" },
    "/users/{userId}/fcmTokens/{tokenId}": { "schema": "#/entities/FCMToken", "description": "User notification tokens" },
    "/users/{userId}/profile/data": { "schema": "object", "description": "User profile information" }
  }
}
