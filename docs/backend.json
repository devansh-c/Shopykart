
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A food item in the menu",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isVeg": { "type": "boolean" },
        "vendorId": { "type": "string" },
        "zoneId": { "type": "string" },
        "restaurantName": { "type": "string" },
        "town": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "price": { "type": "number" }
            }
          },
          "maxItems": 5
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "vendorId"]
    },
    "ServingZone": {
      "title": "Serving Zone",
      "description": "Geographical delivery area",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "city": { "type": "string" },
        "pincodes": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "deliveryCharge": { "type": "number" },
        "minOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["online", "cod"] },
        "paymentStatus": { "type": "string" },
        "utrNumber": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "coinsEarned": { "type": "number" },
        "coinsUsed": { "type": "number" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "zoneId": { "type": "string" },
        "coins": { "type": "number", "default": 0 },
        "isPremium": { "type": "boolean", "default": false },
        "premiumExpiry": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Ticket": {
      "title": "Support Ticket",
      "description": "Customer help request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "description": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/zones/{zoneId}": { "schema": "#/entities/ServingZone", "description": "Global delivery zones" },
    "/vendors/{vendorId}": { "schema": "object", "description": "Store profiles" },
    "/products/{productId}": { "schema": "#/entities/Product", "description": "Global products for search" },
    "/orders/{orderId}": { "schema": "#/entities/Order", "description": "Global orders" },
    "/users/{userId}": { "schema": "#/entities/UserProfile", "description": "User profile information" },
    "/tickets/{ticketId}": { "schema": "#/entities/Ticket", "description": "Support tickets" }
  }
}
